# Production Environment Configuration (billiardsboss.com)
# Copy this file to .env.production and fill in your values
# Used for production deployments

# Database Configuration
# These are used by Docker Compose to set up the PostgreSQL container
# IMPORTANT: Use strong, unique passwords in production!
POSTGRES_USER=billiards
POSTGRES_PASSWORD=generate-very-strong-unique-password-here
POSTGRES_DB=billiards_boss
POSTGRES_PORT=5434

# NextAuth Configuration
# Generate a secure secret with: openssl rand -base64 32
# IMPORTANT: This must be different from development and kept secret!
NEXTAUTH_URL=https://billiardsboss.com
NEXTAUTH_SECRET=your-generated-secret-here-must-be-different-from-development

# Application URLs
# These are used for email links and WebSocket connections
NEXT_PUBLIC_APP_URL=https://billiardsboss.com
NEXT_PUBLIC_WS_URL=https://billiardsboss.com

# Docker Configuration
# Production uses port 3000 (standard)
APP_PORT=3000

# Email Configuration
# Required for email verification and password reset
# Get your API key from https://resend.com
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=noreply@notifications.billiardsboss.com
EMAIL_FROM_NAME="[PROD] Billiards Boss Notifications"
