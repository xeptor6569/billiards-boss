# Development Environment Configuration (dev.billiardsboss.com)
# Copy this file to .env.development and fill in your values
# Used for staging/testing deployments

# Database Configuration
# These are used by Docker Compose to set up the PostgreSQL container
POSTGRES_USER=billiards
POSTGRES_PASSWORD=generate-strong-password-here
POSTGRES_DB=billiards_boss
POSTGRES_PORT=5433

# NextAuth Configuration
# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_URL=https://dev.billiardsboss.com
NEXTAUTH_SECRET=your-generated-secret-here-must-be-different-from-production

# Application URLs
# These are used for email links and WebSocket connections
NEXT_PUBLIC_APP_URL=https://dev.billiardsboss.com
NEXT_PUBLIC_WS_URL=https://dev.billiardsboss.com

# Docker Configuration
# Dev environment uses port 3001 to avoid conflicts with production
APP_PORT=3001

# Email Configuration (optional)
# Required for email verification and password reset
# Get your API key from https://resend.com
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=noreply@notifications.billiardsboss.com
EMAIL_FROM_NAME="Billiards Boss"

# GitHub Configuration (optional, for dev deployment card)
# Required for "Create GitHub Issue" button in dev deployment card
# Get a Personal Access Token from: GitHub → Settings → Developer settings → Personal access tokens
# Token needs 'repo' scope to create issues
GITHUB_TOKEN=your-github-personal-access-token-here
GITHUB_REPO_OWNER=cmarotto
GITHUB_REPO_NAME=billiards-boss

# Dev Deployment Card
# Set to "true" to show dev deployment card on dashboard
NEXT_PUBLIC_IS_DEV=true
