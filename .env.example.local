# Local Development Environment Configuration
# Copy this file to .env.local and fill in your values
# .env.local is gitignored and takes highest priority

# Database Configuration
# For local development, connect to a local PostgreSQL instance
DATABASE_URL=postgresql://billiards:billiards@localhost:5432/billiards_boss

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-generated-secret-here-change-this-in-production

# Application URLs
# These are used for email links and WebSocket connections
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Docker Configuration (optional for local dev)
# Only needed if running via Docker Compose locally
APP_PORT=3000
POSTGRES_PORT=5432

# Email Configuration (optional)
# Required for email verification and password reset
# Get your API key from https://resend.com
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=noreply@notifications.billiardsboss.com
EMAIL_FROM_NAME="[LOCAL] Billiards Boss"

# GitHub Configuration (optional, for dev deployment card)
# Required for "Create GitHub Issue" button in dev deployment card
# Get a Personal Access Token from: GitHub → Settings → Developer settings → Personal access tokens
# Token needs 'repo' scope to create issues
GITHUB_TOKEN=your-github-personal-access-token-here
GITHUB_REPO_OWNER=cmarotto
GITHUB_REPO_NAME=billiards-boss

# Dev Deployment Card
# Set to "true" to show dev deployment card on dashboard
NEXT_PUBLIC_IS_DEV=true
